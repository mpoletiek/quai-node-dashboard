# quai-dash web dashboard as a system service, one instance per user:
#   systemctl enable --now quai-dash@<user>.service
# The instance name is the user it runs as. To read the node's logs and
# its /proc entries (the peer map) that must be the node's own user: with
# the capabilities dropped below, even root can't read another user's
# /proc/<pid>/fd.
#
# Settings: /etc/default/quai-dash (QUAI_DASH_* variables, QUAI_DASH_ARGS)
# and the config file (~<user>/.config/quai-dash/config.toml, else
# /etc/quai-dash/config.toml). Installed by scripts/install-service.sh.

[Unit]
Description=quai-dash web dashboard for a Quai node (as %i)
Documentation=https://github.com/mpoletiek/quai-node-dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=%i
EnvironmentFile=-/etc/default/quai-dash
# $QUAI_DASH_ARGS splits on whitespace; values with spaces belong in the
# config file or a QUAI_DASH_* variable.
ExecStart=/usr/local/bin/quai-dash web $QUAI_DASH_ARGS
Restart=on-failure
RestartSec=5s

# Hardening. quai-dash only reads: the node's logs (often under /home),
# /proc (the node's sockets and fds, same user), its config; and talks
# TCP (node RPC, stratum API, ip-api.com) and listens on one port.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# The peer map reads the node's /proc/<pid>/fd: keep other processes
# visible (ProtectProc=invisible would hide them).
ProtectProc=default
ProcSubset=all
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
