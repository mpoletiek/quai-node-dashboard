#!/sbin/openrc-run
# quai-dash web dashboard for a Quai node (OpenRC). Settings live in
# /etc/conf.d/quai-dash and the config file (~USER/.config/quai-dash/
# config.toml, else /etc/quai-dash/config.toml). Installed by
# scripts/install-service.sh.

description="quai-dash web dashboard for a Quai node"

: "${QUAI_DASH_USER:=quai-dash}"
: "${QUAI_DASH_BIN:=/usr/local/bin/quai-dash}"
# Output goes to /var/log/quai-dash/quai-dash.log. supervise-daemon opens
# it as QUAI_DASH_USER; start_pre makes the directory (its parent is
# root's, so nothing the user owns is touched as root). A QUAI_DASH_LOG
# elsewhere must be in a directory that user can already write.
: "${QUAI_DASH_LOG:=/var/log/quai-dash/quai-dash.log}"

command="${QUAI_DASH_BIN}"
command_args="web ${QUAI_DASH_ARGS}"
command_user="${QUAI_DASH_USER}"
# supervise-daemon restarts quai-dash when it exits unexpectedly.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=10
respawn_period=600
pidfile="/run/${RC_SVCNAME}.pid"
output_log="${QUAI_DASH_LOG}"
error_log="${QUAI_DASH_LOG}"

depend() {
	need net
	after rs-quai go-quai
}

start_pre() {
	if [ "${QUAI_DASH_LOG%/*}" = /var/log/quai-dash ]; then
		checkpath --directory --owner "${QUAI_DASH_USER}" --mode 0750 /var/log/quai-dash
	fi
}
